{
  "name": "aimong-us",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @aimong/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "sim": "pnpm --filter @aimong/server sim"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
