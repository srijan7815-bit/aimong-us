# Copy to .env for local development. Never commit real keys.
PORT=2567
NODE_ENV=development
PUBLIC_URL=http://localhost:2567

# --- LLM providers (any OpenAI-compatible endpoint). Add only the ones you use.
# Leave empty: the residents stay silent and the game runs on deterministic bodies.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cost + concurrency guards
MAX_COST_USD_PER_GAME=1.00
MAX_LLM_CONCURRENCY=6
# 1 = deterministic fake LLM (tests / simulation harness)
LLM_MOCK=0
# Model ids per tier. Everything we call must answer with content, not only
# reasoning — see DECISIONS.md #27 for the NIM models that actually work.
NIM_PLAY_MODEL=nvidia/nemotron-3.5-bolt-e4b
NIM_MEETING_MODEL=nvidia/nemotron-3.5-bolt-e4b
# Requests per minute per provider (NIM free tier is ~40).
NIM_RPM=30
OPENROUTER_RPM=18
LLM_TIMEOUT_MS=20000

# --- Rooms
ROOM_CODE_LENGTH=5
MAX_ROOMS=3
LOG_LEVEL=info

# Optional: protects the /admin page (live rooms, AI thoughts, cost, kill switch)
ADMIN_TOKEN=
