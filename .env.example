# Copy to .env for local development. Never commit real keys.
PORT=2567
NODE_ENV=development
PUBLIC_URL=http://localhost:2567

# --- LLM providers (any OpenAI-compatible endpoint). Add only the ones you use.
# Leave empty: the game runs on deterministic autopilot until keys exist (M5+).
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Cost + concurrency guards
MAX_COST_USD_PER_GAME=1.00
MAX_LLM_CONCURRENCY=6
# 1 = deterministic fake LLM (tests / simulation harness)
LLM_MOCK=0

# --- Rooms
ROOM_CODE_LENGTH=5
MAX_ROOMS=3
LOG_LEVEL=info

# Optional: protects the /admin page (live rooms, AI thoughts, cost, kill switch)
ADMIN_TOKEN=
